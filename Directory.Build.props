<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <!-- When using Previews (and possible RCs) then removed comments
    <LangVersion>preview</LangVersion>
    -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <!-- .NET 11 introduced the new runtime based async implementation,
         which in .NET 11 is opt-in
         TODO: Remove once runtime async becomes the default (In .NET 12?)
    -->
    <Features>$(Features);runtime-async=on</Features>
  </PropertyGroup>

  <!-- Enable code analysis + Warnings as errors -->
  <PropertyGroup>
    <WarningLevel>9999</WarningLevel> <!-- All warnings -->
    <AnalysisLevel>latest-all</AnalysisLevel>
    <!-- Treat warnings as errors in general -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CA1515</WarningsNotAsErrors>
    <!-- Nullable settings from https://blog.ndepend.com/c-nullable-types-explained/ -->
    <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
    <!-- disable, annotations, warnings, enable = All = Annotations + Warnings -->
    <Nullable>enable</Nullable>
  </PropertyGroup>
</Project>
